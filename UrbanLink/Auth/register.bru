meta {
  name: register
  type: http
  seq: 2
}

post {
  url: http://localhost:8000/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "name": "mine",
    "email": "mine@example.com",
    "password": "password",
    "password_confirmation": "password",
    "role": "citizen"
    
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
